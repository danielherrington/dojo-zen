{
  "hosting": [
    {
      "target": "dojo",
      "public": "src/dojo/web",
      "rewrites": [
        {
          "source": "/mcp",
          "run": {
            "serviceId": "dojo-zen",
            "region": "us-central1"
          }
        },
        {
          "source": "/mcp/**",
          "run": {
            "serviceId": "dojo-zen",
            "region": "us-central1"
          }
        },
        {
          "source": "**",
          "run": {
            "serviceId": "dojo-zen",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
