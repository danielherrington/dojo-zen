# ==============================================================================
# ClassDojo Agent Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# ClassDojo Credentials
# ------------------------------------------------------------------------------
DOJO_EMAIL=your-email@example.com
DOJO_PASSWORD=your-dojo-password

# Session file path (stores cookies after successful login)
DOJO_SESSION_FILE=data/session.json

# SQLite Database path
DOJO_DB_PATH=data/dojo.db

# ------------------------------------------------------------------------------
# Email (SMTP) Settings
# ------------------------------------------------------------------------------
# To receive recaps via email, configure your SMTP server.
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_USE_TLS=true

# Sender and Recipient
EMAIL_FROM="ClassDojo Daily Briefing <your-email@gmail.com>"
EMAIL_TO=your-inbox@example.com

# ------------------------------------------------------------------------------
# Digest / Summarization Settings
# ------------------------------------------------------------------------------
# (Optional) If you have a Gemini API key, you can provide it for
# enhanced natural language synthesis. The agent also includes a built-in
# heuristic extractor that works without any external API key.
GEMINI_API_KEY=
